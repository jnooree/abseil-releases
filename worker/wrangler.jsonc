{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abseil-release-webhook",
  "main": "index.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "https://webhooks.jnoor.ee/github.com/jnooree/abseil-cpp",
      "zone_name": "jnoor.ee"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
